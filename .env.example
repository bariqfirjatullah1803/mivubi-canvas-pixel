# Salin ke .env dan isi. Jangan commit .env.

# Database (Neon). DATABASE_URL_DEV dipakai lebih dulu kalau ada,
# jadi pengembangan tidak menyentuh database produksi.
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
DATABASE_URL_DEV=postgresql://user:pass@host/mivubi_dev?sslmode=require

# Rahasia tanda tangan, masing-masing minimal 32 karakter acak.
# ADMIN_PASSWORD_HASH dihasilkan: npm run admin:hash-password "password"
DEVICE_TOKEN_PEPPER=
USER_SESSION_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Penyimpanan objek Cloudflare R2 (API S3) untuk desain poster.
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
